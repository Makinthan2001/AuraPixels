datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String   @unique
  password         String?
  provider         String   @default("local")
  profileImage     String?
  verified         Boolean  @default(false)
  resetOtp         String?
  resetOtpExpiry   DateTime?
  resetOtpVerified Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refreshTokens RefreshToken[]
  wallpapers    Wallpaper[]
  favorites     Favorite[]
  history       History[]
  likes         Like[]

  @@index([name])
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Wallpaper {
  id         Int        @id @default(autoincrement())
  imageUrl   String
  prompt     String
  category   String?
  style      String?
  resolution String?
  tags       String[]
  likesCount Int        @default(0)
  userId     Int?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  favorites  Favorite[]
  likes      Like[]
  createdAt  DateTime   @default(now())

  @@index([userId])
  @@index([category])
  @@index([style])
  @@index([category, createdAt])
  @@index([style, createdAt])
  @@index([createdAt])
  @@index([likesCount])
  @@index([likesCount(sort: Desc), createdAt(sort: Desc)])
  @@index([userId, createdAt])
}

model Favorite {
  id          Int       @id @default(autoincrement())
  userId      Int
  wallpaperId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, wallpaperId])
  @@index([userId])
}

model Like {
  id          Int       @id @default(autoincrement())
  userId      Int
  wallpaperId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, wallpaperId])
  @@index([userId])
  @@index([wallpaperId])
  @@index([userId, createdAt])
}

model History {
  id         Int      @id @default(autoincrement())
  userId     Int
  prompt     String
  imageUrl   String
  style      String?
  resolution String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([style])
  @@index([createdAt])
}
